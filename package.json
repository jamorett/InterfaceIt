{
  "name": "claudeinterface",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "bridge",
    "ui"
  ],
  "scripts": {
    "dev": "tsx watch bridge/src/main.ts --dev",
    "build": "npm run build -w ui",
    "start": "npm run build && tsx bridge/src/main.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p shared && tsc -p bridge && tsc -p ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
